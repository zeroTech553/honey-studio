# ─────────────────────────────────────────────────────────────
# Honey Studio — environment
# Copy to .env.local and fill in. Everything except the LiveKit
# block is required for the real backend; with NO Supabase vars
# the app boots into a local dev store so you can click around.
# ─────────────────────────────────────────────────────────────

# Supabase (Auth + Postgres + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...         # server-only, never expose

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5                # cheaper: claude-haiku-4-5-20251001
ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5-20251001  # used for summarisation

# ── Model provider ───────────────────────────────────────────
# auto (default) = Anthropic if ANTHROPIC_API_KEY is set, else Cloudflare,
# else the local dev engine. Force one with: anthropic | cloudflare | local
ENGINE_PROVIDER=auto

# Cloudflare Workers AI (alternative to Anthropic)
# Account ID: run `wrangler whoami`
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/swiss-ai/apertus-v1.5-8b
# Optional AI Gateway (adds the cf-aig-gateway-id header)
CLOUDFLARE_AI_GATEWAY_ID=

# Upstash Redis (rate limiting). Omit to fall back to an in-memory limiter.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Rate limits (optional overrides)
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300

# LiveKit — OPTIONAL for now. Without these, /api/call/token returns 501
# and the mock call provider keeps the UI working.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public site URL — used for Supabase magic-link / OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
